<Window x:Class="ThumbnailExplorer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ThumbnailExplorer"
        Title="Thumbnail Explorer" Icon="Assets/ThumbnailExplorer.ico" Width="1400" Height="880" MinWidth="1080" MinHeight="660"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource Workspace}" Foreground="{DynamicResource InkText}"
        FontFamily="Segoe UI, Yu Gothic UI" FontSize="13" Closing="WindowClosing"
        PreviewKeyDown="WindowKeyDown">
    <Window.Resources>
        <SolidColorBrush x:Key="Workspace" Color="#F1F4F9" />
        <SolidColorBrush x:Key="Panel" Color="#FFFFFF" />
        <SolidColorBrush x:Key="Field" Color="#FFFFFF" />
        <SolidColorBrush x:Key="InkText" Color="#17243A" />
        <SolidColorBrush x:Key="Muted" Color="#52627C" />
        <SolidColorBrush x:Key="Line" Color="#D7DEEA" />
        <SolidColorBrush x:Key="Well" Color="#EEF1FA" />
        <SolidColorBrush x:Key="Hover" Color="#E5E2FC" />
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#6753DC" />
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White" />
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#575087" />
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="White" />
        <BooleanToVisibilityConverter x:Key="Visible" />
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Field}" />
            <Setter Property="Foreground" Value="{DynamicResource InkText}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Face" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="#8F7CFF" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Face" Property="Opacity" Value=".78" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Face" Property="Opacity" Value=".5" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#6753DC" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#6753DC" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource Field}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
            <Setter Property="Foreground" Value="{DynamicResource InkText}" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource InkText}" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource InkText}" />
        </Style>
        <Style x:Key="ThemedToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource InkText}" />
            <Setter Property="Background" Value="{DynamicResource Field}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Face" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Background" Value="{DynamicResource Hover}" /></Trigger>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Face" Property="Background" Value="{DynamicResource Hover}" /><Setter TargetName="Face" Property="BorderBrush" Value="#8F7CFF" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Face" Property="Opacity" Value=".55" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource InkText}" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Row" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Content" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource Hover}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Foreground" Value="{DynamicResource InkText}" />
            <Setter Property="Background" Value="{DynamicResource Field}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Style="{StaticResource ThemedToggle}" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Grid IsHitTestVisible="False" Margin="8,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /></Grid.ColumnDefinitions>
                                <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" VerticalAlignment="Center" ClipToBounds="True" />
                                <Path Grid.Column="1" Data="M 0 0 L 3.5 3.5 L 7 0" Stroke="{DynamicResource InkText}"
                                      HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False">
                                <Border Background="{DynamicResource Field}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                        MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="{DynamicResource InkText}" />
            <Setter Property="Padding" Value="4,3" />
        </Style>
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource Field}" />
            <Setter Property="Foreground" Value="{DynamicResource InkText}" />
        </Style>
        <Style x:Key="SectionLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,13,0,5" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#17243A" Padding="22,13">
            <StackPanel Orientation="Horizontal">
                <Image Source="Assets/ThumbnailExplorer.png" Width="34" Height="34" Margin="0,0,11,0"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="Thumbnail Explorer" Foreground="White" FontSize="20"
                           FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0"
                Padding="20,8">
            <TextBlock x:Name="Status" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" />
        </Border>

        <Grid Margin="18,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="184" MinWidth="125" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" MinWidth="340" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="400" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                    CornerRadius="10" Padding="8,12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{local:L Navigation}" FontWeight="SemiBold" Margin="5,0,0,10" />
                    <TreeView x:Name="FolderTree" Background="Transparent" BorderThickness="0"
                              Foreground="{DynamicResource InkText}" SelectedItemChanged="FolderTreeSelectionChanged"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              AutomationProperties.Name="{local:L FolderNavigation}" />
                </DockPanel>
            </Border>
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext" Background="Transparent" />
            <Border Grid.Column="2" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                    CornerRadius="10" Padding="15">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="BackButton" Content="←" Click="BackClick" ToolTip="{local:L Back}" AutomationProperties.Name="{local:L Back}" Padding="9,5" />
                            <Button x:Name="ForwardButton" Content="→" Click="ForwardClick" ToolTip="{local:L Forward}" AutomationProperties.Name="{local:L Forward}" Padding="9,5" Margin="4,0,0,0" />
                            <Button x:Name="UpButton" Content="↑" Click="UpClick" ToolTip="{local:L ParentFolder}" AutomationProperties.Name="{local:L ParentFolder}" Padding="9,5" Margin="4,0,7,0" />
                        </StackPanel>
                        <TextBox x:Name="PathBox" Grid.Column="1" KeyDown="PathKeyDown" AutomationProperties.Name="{local:L FolderPath}" />
                        <Button Grid.Column="2" Content="{local:L ChooseFolder}" Click="ChooseFolderClick" Margin="7,0,0,0" />
                    </Grid>

                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,11">
                        <Button Content="{local:L NewFolder}" Click="NewFolderClick" Margin="0,0,5,4" />
                        <Button x:Name="RenameButton" Content="{local:L Rename}" Click="RenameClick" Margin="0,0,5,4" />
                        <Button x:Name="CopyButton" Content="{local:L Copy}" Click="CopyClick" Margin="0,0,5,4" />
                        <Button x:Name="CutButton" Content="{local:L Cut}" Click="CutClick" Margin="0,0,5,4" />
                        <Button Content="{local:L Paste}" Click="PasteClick" Margin="0,0,5,4" />
                        <Button x:Name="ZipButton" Content="{local:L CompressZip}" Click="ZipClick" Margin="0,0,5,4" />
                        <Button Content="{local:L Refresh}" Click="RefreshClick" Margin="0,0,5,4" />
                    </WrapPanel>
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <ComboBox x:Name="SortPicker" Width="116" Margin="0,0,6,4" SelectionChanged="SortChanged" AutomationProperties.Name="{local:L Sort}">
                            <ComboBoxItem Content="{local:L SortName}" /><ComboBoxItem Content="{local:L SortModified}" />
                            <ComboBoxItem Content="{local:L SortType}" /><ComboBoxItem Content="{local:L SortSize}" />
                        </ComboBox>
                        <CheckBox x:Name="DescendingToggle" Content="{local:L Descending}" Margin="0,6,11,4" Checked="SortOrderChanged" Unchecked="SortOrderChanged" />
                        <CheckBox x:Name="HiddenToggle" Content="{local:L HiddenItems}" Margin="0,6,11,4" Checked="HiddenChanged" Unchecked="HiddenChanged" />
                        <CheckBox x:Name="ExtensionsToggle" Content="{local:L Extensions}" Margin="0,6,11,4" Checked="ExtensionsChanged" Unchecked="ExtensionsChanged" />
                        <ComboBox x:Name="ThemePicker" Width="99" Margin="0,0,10,4" SelectionChanged="ThemeChanged" AutomationProperties.Name="{local:L Theme}">
                            <ComboBoxItem Content="{local:L Light}" /><ComboBoxItem Content="{local:L Dark}" /><ComboBoxItem Content="{local:L Beige}" />
                        </ComboBox>
                        <Slider x:Name="ZoomSlider" Minimum=".65" Maximum="1.65" TickFrequency=".05" IsSnapToTickEnabled="True"
                                Width="85" VerticalAlignment="Center" ValueChanged="ZoomChanged" ToolTip="{local:L ZoomHint}"
                                AutomationProperties.Name="{local:L Zoom}" Margin="0,0,4,4" />
                        <TextBlock x:Name="ZoomLabel" VerticalAlignment="Center" Margin="0,0,0,4" />
                    </WrapPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="180" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="FolderTitle" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />
                        <DockPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock DockPanel.Dock="Left" Text="{local:L Search}" VerticalAlignment="Center" Margin="0,0,7,0" />
                            <TextBox x:Name="SearchBox" TextChanged="SearchChanged" AutomationProperties.Name="{local:L SearchByName}" />
                        </DockPanel>
                    </Grid>

                    <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="CountLabel" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="PreviousPage" Content="{local:L PreviousPage}" Click="PreviousPageClick" />
                            <Button x:Name="NextPage" Content="{local:L NextPage}" Click="NextPageClick" Margin="6,0,0,0" />
                        </StackPanel>
                    </Grid>
                    <Grid>
                        <TextBlock x:Name="EmptyFolder" Text="{local:L EmptyFolder}" Foreground="{DynamicResource Muted}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <ListBox x:Name="Files" Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 SelectionMode="Extended" SelectionChanged="FileSelectionChanged" MouseDoubleClick="FileDoubleClick" PreviewMouseWheel="FilesMouseWheel"
                                 KeyDown="FilesKeyDown" AllowDrop="True" DragOver="FilesDragOver" Drop="FilesDrop">
                            <ListBox.ContextMenu>
                                <ContextMenu Opened="FileMenuOpened">
                                    <MenuItem Tag="single" Header="{local:L Open}" Click="OpenClick" />
                                    <MenuItem Tag="single" Header="{local:L Rename}" InputGestureText="F2" Click="RenameClick" />
                                    <Separator />
                                    <MenuItem Tag="multiple" Header="{local:L Copy}" InputGestureText="Ctrl+C" Click="CopyClick" />
                                    <MenuItem Tag="multiple" Header="{local:L Cut}" InputGestureText="Ctrl+X" Click="CutClick" />
                                    <MenuItem Header="{local:L Paste}" InputGestureText="Ctrl+V" Click="PasteClick" />
                                    <Separator />
                                    <MenuItem Tag="multiple" Header="{local:L CompressZip}" Click="ZipClick" />
                                    <MenuItem Header="{local:L NewFolder}" Click="NewFolderClick" />
                                </ContextMenu>
                            </ListBox.ContextMenu>
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="4" />
                                    <Setter Property="Margin" Value="2" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Tile" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                                                        CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tile" Property="Background" Value="{DynamicResource Hover}" /></Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Tile" Property="Background" Value="{DynamicResource Hover}" />
                                                        <Setter TargetName="Tile" Property="BorderBrush" Value="#8F7CFF" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:FileEntry}">
                                    <StackPanel Width="125" ToolTip="{Binding Name}">
                                        <StackPanel.LayoutTransform>
                                            <ScaleTransform ScaleX="{Binding TileScale, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            ScaleY="{Binding TileScale, RelativeSource={RelativeSource AncestorType=Window}}" />
                                        </StackPanel.LayoutTransform>
                                        <Border Width="108" Height="94" Background="{DynamicResource Well}" CornerRadius="8">
                                            <Grid>
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Glyph}" FontSize="29" FontFamily="Segoe MDL2 Assets"
                                                               HorizontalAlignment="Center" Foreground="#7060CF" />
                                                    <TextBlock Text="{Binding Kind}" Margin="0,4,0,0" HorizontalAlignment="Center"
                                                               Foreground="{DynamicResource Muted}" FontSize="11" />
                                                </StackPanel>
                                                <Image Source="{Binding Thumbnail}" Stretch="Uniform" Visibility="{Binding HasThumbnail, Converter={StaticResource Visible}}"
                                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                                <Border Background="#6753DC" Width="9" Height="9" CornerRadius="5" Margin="4"
                                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                                        Visibility="{Binding IsCustom, Converter={StaticResource Visible}}" />
                                            </Grid>
                                        </Border>
                                        <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource InkText}" Height="33" Margin="2,5,2,0" TextAlignment="Center"
                                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </DockPanel>
            </Border>

            <Border Grid.Column="4" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                    CornerRadius="10" Padding="15">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock Text="{local:L ThumbnailEditor}" FontSize="21" FontWeight="SemiBold" />
                        <TextBlock x:Name="SelectedName" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Muted}" />
                    </StackPanel>
                    <DockPanel x:Name="Editor">
                        <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="RemoveButton" Content="{local:L RemoveThumbnail}" Padding="8,6" Click="RemoveClick" />
                            <Button Grid.Column="1" x:Name="OpenButton" Content="{local:L OpenFile}" Click="OpenClick" Margin="6,0" />
                            <Button Grid.Column="2" Content="{local:L Save}" Click="SaveClick" Style="{StaticResource Primary}" MinWidth="85" />
                        </Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,0,5,0">
                                <Border Background="{DynamicResource Well}" CornerRadius="8" Padding="8">
                                    <Viewbox Width="258" Height="258" Stretch="Uniform">
                                        <Grid x:Name="Surface" Width="512" Height="512" Background="#F8F7FF" ClipToBounds="True">
                                            <Image x:Name="BackgroundImage" Stretch="UniformToFill" IsHitTestVisible="False" />
                                            <Canvas x:Name="Layers" Background="Transparent"
                                                    MouseLeftButtonDown="LayerMouseDown" MouseMove="LayerMouseMove"
                                                    MouseLeftButtonUp="LayerMouseUp" LostMouseCapture="LayerLostCapture" />
                                            <InkCanvas x:Name="Ink" Background="Transparent" EditingMode="None"
                                                       EditingModeInverted="None" IsHitTestVisible="False" />
                                        </Grid>
                                    </Viewbox>
                                </Border>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="{local:L AddImage}" Click="ChooseImageClick" />
                                    <Button x:Name="RemoveImageButton" Content="{local:L RemoveImage}" Click="RemoveImageClick" Margin="5,0,0,0" />
                                </StackPanel>

                                <TextBlock Text="{local:L TextAndShapes}" Style="{StaticResource SectionLabel}" />
                                <WrapPanel Margin="0,0,0,5">
                                    <Button Content="{local:L AddText}" Click="AddTextClick" Margin="0,0,5,4" />
                                    <ComboBox x:Name="ShapePicker" Width="93" SelectedIndex="0" Margin="0,0,4,4" AutomationProperties.Name="{local:L ShapeType}">
                                        <ComboBoxItem Content="{local:L Rectangle}" /><ComboBoxItem Content="{local:L Ellipse}" /><ComboBoxItem Content="{local:L Triangle}" />
                                    </ComboBox>
                                    <Button Content="{local:L AddShape}" Click="AddShapeClick" Margin="0,0,4,4" />
                                    <Button x:Name="RemoveLayerButton" Content="{local:L Delete}" Click="RemoveLayerClick" Margin="0,0,0,4" />
                                </WrapPanel>
                                <DockPanel x:Name="LayerControls" LastChildFill="True">
                                    <Button x:Name="LayerForwardButton" DockPanel.Dock="Right" Content="{local:L BringForward}" Click="LayerForwardClick" Padding="7,3" Margin="4,0,0,0" />
                                    <Button x:Name="LayerBackwardButton" DockPanel.Dock="Right" Content="{local:L SendBackward}" Click="LayerBackwardClick" Padding="7,3" Margin="4,0,0,0" />
                                    <ComboBox x:Name="LayerPicker" SelectionChanged="LayerSelectionChanged" AutomationProperties.Name="{local:L Layer}" />
                                </DockPanel>
                                <StackPanel x:Name="TextProperties" Margin="0,6,0,0">
                                <TextBox x:Name="CaptionInput" MaxLength="500" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="70" MinHeight="31"
                                         VerticalScrollBarVisibility="Auto" TextChanged="CaptionInputChanged" AutomationProperties.Name="{local:L Text}" />
                                <Grid Margin="0,5,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="75" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="FontPicker" IsTextSearchEnabled="True" SelectionChanged="FontChanged" AutomationProperties.Name="{local:L Font}" />
                                    <ComboBox x:Name="FontSizePicker" Grid.Column="1" Margin="5,0,0,0" SelectionChanged="FontChanged" AutomationProperties.Name="{local:L FontSize}" />
                                    <Button Grid.Column="2" x:Name="TextColorButton" Content="{local:L TextColor}" Click="TextColorClick" Margin="5,0,0,0" />
                                </Grid>

                                </StackPanel>
                                <StackPanel x:Name="ShapeProperties" Margin="0,6,0,0" Orientation="Horizontal">
                                    <TextBlock Text="{local:L Width}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <ComboBox x:Name="WidthPicker" Width="55" SelectionChanged="ShapeSizeChanged" AutomationProperties.Name="{local:L ShapeWidth}" />
                                    <TextBlock Text="{local:L Height}" VerticalAlignment="Center" Margin="8,0,4,0" />
                                    <ComboBox x:Name="HeightPicker" Width="55" SelectionChanged="ShapeSizeChanged" AutomationProperties.Name="{local:L ShapeHeight}" />
                                    <Button x:Name="ShapeColorButton" Content="{local:L Fill}" Click="ShapeColorClick" Margin="6,0,0,0" />
                                </StackPanel>
                                <TextBlock Text="{local:L Drawing}" Style="{StaticResource SectionLabel}" />
                                <WrapPanel>
                                    <ToggleButton Style="{StaticResource ThemedToggle}" x:Name="PenButton" Content="{local:L Pen}" Checked="PenChecked" Unchecked="PenUnchecked"
                                                  MinHeight="32" Padding="10,5" VerticalContentAlignment="Center" />
                                    <Button x:Name="BrushColorButton" Content="{local:L PenColor}" Click="BrushColorClick" Margin="5,0,0,0" />
                                    <ComboBox x:Name="BrushSizePicker" Width="53" Margin="5,0,0,0" SelectionChanged="BrushSizeChanged" AutomationProperties.Name="{local:L PenWidth}" />
                                    <ToggleButton Style="{StaticResource ThemedToggle}" x:Name="EraserButton" Content="{local:L Eraser}" Checked="EraserChecked" Unchecked="EraserUnchecked"
                                                  Margin="5,0,0,0" Padding="5,4" VerticalContentAlignment="Center" />
                                    <Button x:Name="UndoButton" Content="↶" AutomationProperties.Name="{local:L UndoInk}" ToolTip="{local:L UndoInk}" Click="UndoClick" Margin="5,0,0,0" />
                                    <Button x:Name="ClearInkButton" Content="{local:L ClearInk}" Click="ClearInkClick" Margin="5,0,0,0" />
                                </WrapPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
